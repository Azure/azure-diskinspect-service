echo,### Guest Agent Core Logs ###
echo,### Purpose: Collect the core Windows Guest Agent log bundle. ###
echo,### Covers: Telemetry, TransparentInstaller, WaAppAgent, WindowsAzure config XML, AggregateStatus, AppAgentRuntime, and MonitoringAgent logs. ###
echo,### Use when: Use for Windows Guest Agent, WireServer, provisioning-agent, and basic extension orchestration issues. ###
ll,/WindowsAzure
ll,/Packages/Plugins
copy,/WindowsAzure/Logs/Telemetry.log
copy,/WindowsAzure/Logs/TransparentInstaller.log
copy,/WindowsAzure/Logs/WaAppAgent.log
copy,/WindowsAzure/config/*.xml
copy,/WindowsAzure/Logs/AggregateStatus/aggregatestatus*.json
copy,/WindowsAzure/Logs/AppAgentRuntime.log
copy,/WindowsAzure/Logs/MonitoringAgent.log
copy,/WindowsAzure/GuestAgent*/CommonAgentConfig.config
